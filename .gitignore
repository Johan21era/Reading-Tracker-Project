# macOS noise
.DS_Store

# Local Obsidian vault configuration
.obsidian/

# Xcode user-state (machine-local)
xcuserdata/
*.xcuserstate

# Build/coverage artifacts
*.profraw
DerivedData/
build/
*.xcresult/
*.xctestrun

# Packaged Mirage runtime (staged locally; never commit a 47 MB interpreter)
.mirage-runtime/
dist/

# Generated code-analysis output — track the graph deliverables, ignore the ephemera
graphify-out/**
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/graph-3d.html
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json
!graphify-out/cost.json
# graph-3d-full.html is generated on demand (~7.7 MB) and stays local
graphify-out/graph-3d-full.html

# Owner's kept campaign snapshots (frozen at close; canonical, moving copies live in docs/integration/)
/merge-log.md
/RT_Mirage_Codebase_Merge_Playbook.md
