<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- G2: CFBundleIdentifier is supplied by PRODUCT_BUNDLE_IDENTIFIER.
	     The old empty key was confusing and could shadow the generated value. -->
	<!-- ROADMAP 3.2 (RA-002 / NA-4): usage descriptions for permissions this
	     app actually requests at runtime. GENERATE_INFOPLIST_FILE=YES merges
	     these keys with the generated plist.
	     • Apple events: AudioMonitorService asks Music.app / Spotify for the
	       currently playing track once per minute during reading sessions.
	     • When-in-use location: LocationProvider calls requestWhenInUseAuthorization()
	       so weather snapshots can be attached to sessions. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>AsterismaV2.0 checks Music and Spotify to remember what you were listening to while you read, so your reading analytics can include your audio environment.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AsterismaV2.0 uses your approximate location to record the weather conditions during your reading sessions.</string>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.apple.ibooks.epub</string>
			<key>UTTypeDescription</key>
			<string>iBooks EPUB package</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.directory</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
